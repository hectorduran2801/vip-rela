# ───────── Angular (público: SOLO la clave publicable) ─────────
SUPABASE_URL=https://ekhxxedpqnjpibpmpcmf.supabase.co
SUPABASE_PUBLISHABLE_KEY=
API_URL=/api/v1

# ───────── API Fastify (SOLO servidor, nunca en Git ni en Angular) ─────────
PORT=3000
DATABASE_URL=                 # conexión PostgreSQL (la API ejecuta cada consulta como el usuario autenticado)
SUPABASE_JWT_SECRET=          # secreto HS256 del proyecto, o bien:
SUPABASE_JWKS_URL=            # JWKS del proyecto (claves asimétricas)
SUPABASE_SERVICE_ROLE_KEY=    # solo para invitar usuarios (Admin API)
APP_URL=                      # URL pública de la app (enlace de las invitaciones)
CORS_ORIGINS=                 # orígenes permitidos, separados por coma
RATE_LIMIT_PER_MINUTE=120
# ALLOW_SHARED_DB=yes         # la API se niega a arrancar contra Supabase salvo que lo confirmes

# ───────── Worker de WhatsApp (SOLO servidor) ─────────
SESSION_ENCRYPTION_KEY=       # openssl rand -base64 32 (cifra las sesiones de OpenWA)
WHATSAPP_DRY_RUN=true         # true = no envía mensajes reales. Cambiar solo con autorización expresa.
WHATSAPP_ADAPTER=openwa       # SOLO la CONEXIÓN/QR: openwa (real) | fake (pruebas). Conectar la cuenta != autorizar envíos.
# CHROME_PATH=                # por defecto: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome si existe
# OPENWA_SESSION_PATH=.openwa-sessions   # donde OpenWA guarda su sesión (reanuda sin QR); ya está en .gitignore

# ───────── Operación ─────────
APP_TIMEZONE=America/Panama

# Motor de cobranza (API): genera las cuotas diarias; independiente de OpenWA. false = desactivado (pruebas).
BILLING_ENGINE=true
BILLING_ENGINE_INTERVAL_SECONDS=300
