{
  "name": "@vip/whatsapp-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Worker independiente de WhatsApp (cola de notificaciones + sesiones). Separado de la API.",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env src/main.ts",
    "dev:watch": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "smoke:openwa": "tsx scripts/smoke-openwa.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@open-wa/wa-automate": "5.13.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
